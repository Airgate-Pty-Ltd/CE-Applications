# ============================================================
# Conform-Edge RegIntel™ — Environment Variables
# Copy this to .env.local (Next.js frontend) and .env (worker)
# ============================================================

# --- Regulatory sources ---
# None required. The worker pulls from public authority APIs (Federal
# Register) which need no key and no account.
#
# There is no LLM and no search API in this product. Every finding comes from
# the publishing authority's own structured record.

# --- Supabase ---
# The RegIntel frontend is a STATIC site; it only needs the public URL + anon
# key (RLS is the security gate). SUPABASE_SERVICE_ROLE_KEY is NOT used by the
# frontend — only by the ingestion job (scraper/). Never ship it in the bundle.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Shared cross-subdomain login ---
# RegIntel and the Conform-Edge website share ONE Supabase session via a cookie
# scoped to the parent domain, so logging in on the website logs you into
# RegIntel (no handoff token). Set this to the shared parent on BOTH apps in
# production; leave UNSET for local dev / preview deploys.
NEXT_PUBLIC_COOKIE_DOMAIN=.conform-edge.com

# Where the dashboard sends users who are not signed in (the website login).
NEXT_PUBLIC_WEBSITE_URL=https://conform-edge.com

# NOTE: the HMAC handoff (HANDOFF_SECRET / lib/handoff.ts) is SUPERSEDED by the
# shared-session model above and is no longer required.

# Admin email for the in-product admin panel. Leave unset to disable the admin route.
NEXT_PUBLIC_ADMIN_EMAIL=

# --- Stripe (DEPRECATED — no longer used) ---
# Billing moved to the Conform-Edge website; RegIntel holds no Stripe keys.
# These remain only for reference and can be removed from your deployment.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cron / Worker Security ---
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your_long_random_secret_here
WORKER_URL=https://your-worker-service.railway.app

# --- App ---
NEXT_PUBLIC_APP_URL=https://regintel.conform-edge.com
# ADMIN_EMAIL is deprecated. Use NEXT_PUBLIC_ADMIN_EMAIL to gate admin access.
# ADMIN_EMAIL=b.r.olea.gqm@gmail.com

# ============================================================
# Required versus optional quick reference
# ============================================================
# Runtime required (app will fail to start or function):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   HANDOFF_SECRET, NEXT_PUBLIC_WEBSITE_URL, CRON_SECRET, WORKER_URL
#
# Runtime optional:
#   NEXT_PUBLIC_ADMIN_EMAIL — leave unset to disable the admin panel entirely
#   NEXT_PUBLIC_APP_URL — used in absolute redirects; falls back to request host
#
# Build-time only:
#   None. All env vars are read at runtime so the same build can deploy to staging
#   and production with different environment values.