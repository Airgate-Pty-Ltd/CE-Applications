{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conform-edge/requirement-intelligence-library/obligation/1.0.0-rc.1",
  "title": "Canonical auditable-obligation record (freeze candidate 1.0.0-rc.1)",
  "description": "Descriptive schema. The executable contract is src/library.js (validateRecord / validatePack), which additionally enforces cross-record rules: exact citation against the pack hierarchy, uniqueness, relationship and concept resolution, state coupling (APPROVED requires VERIFIED source), and IP rules. All text is Conform-Edge authored; no standard text may be carried.",
  "type": "object",
  "required": ["obligationId", "standard", "edition", "clauseRef", "title", "interpretation", "intent", "expectedControl", "applicability", "verificationActivities", "auditQuestions", "interviewQuestions", "expectedEvidence", "sampling", "processes", "processRelationships", "riskConsiderations", "commonFailureIndicators", "alternativeValidImplementations", "relatedRequirements", "aspects", "rebuttalChecks", "shouldBe", "shouldBeTerms", "sourceVerification", "technicalApproval", "contentVersion", "reviewers"],
  "properties": {
    "obligationId": { "type": "string", "pattern": "^OB-[0-9A-Za-z.\\-]+$", "description": "Stable, unique identifier. Coverage is computed from these identifiers." },
    "standard": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "publisher": { "type": "string" } } },
    "edition": { "type": "object", "required": ["label"], "properties": { "label": { "type": "string" } }, "description": "Must equal the pack's edition." },
    "clauseRef": { "type": "string", "pattern": "^\\d+(\\.\\d+)*(\\([a-z]\\)(\\(\\d+\\))?)?$", "description": "Exact reference through the lettered/numbered subdivision. Must be a catalogued hierarchy LEAF; never invented." },
    "title": { "type": "string" },
    "interpretation": { "type": "string", "description": "Independently authored reading of the applicable requirement." },
    "intent": { "type": "string" },
    "expectedControl": { "type": "string", "description": "Expected control or outcome." },
    "applicability": { "type": "object", "required": ["conditions"], "properties": { "conditions": { "type": "object", "description": "Resolver conditions (activitiesAny, regulatorsAny, certificationsAny, flagsAll, excludeIfFlagsAny); {} = unconditional" }, "note": { "type": "string" } } },
    "objective": { "type": "string" },
    "method": { "type": "string" },
    "verificationActivities": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "auditQuestions": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "interviewQuestions": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "expectedEvidence": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "sampling": { "type": "object", "required": ["population", "guidance"], "properties": { "population": { "type": "string" }, "guidance": { "type": "string" }, "minSample": { "type": "integer", "minimum": 0 } } },
    "processes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "processRelationships": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "riskConsiderations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "commonFailureIndicators": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "alternativeValidImplementations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "relatedRequirements": { "type": "array", "items": { "type": "string" }, "description": "Obligation ids; must resolve within the pack; never self." },
    "aspects": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "required": { "type": "boolean" } } } },
    "rebuttalChecks": { "type": "array", "items": { "type": "object", "required": ["id", "text"] }, "description": "Alternative explanations to evaluate before a finding." },
    "shouldBe": { "type": "string", "description": "Accurate paraphrase for NCRs; not source text." },
    "shouldBeTerms": { "type": "array", "items": { "type": "string" } },
    "concepts": { "type": "array", "items": { "type": "string" }, "description": "Concept ids defined in the pack's shared concept graph." },
    "sourceVerification": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PENDING", "VERIFIED", "REJECTED"] } } },
    "technicalApproval": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["PENDING", "APPROVED", "REJECTED"] }, "approver": { "type": ["string", "null"] }, "date": { "type": ["string", "null"] } } },
    "authoredBy": { "type": "string" },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "contentVersion": { "type": "string" }
  },
  "additionalProperties": true
}
