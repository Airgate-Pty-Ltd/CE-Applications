# EDCAT AI environment config (sample)
EDCAT_DB_URL=postgres://user:pass@localhost:5432/edcat
RETRIEVAL_PROVIDER=postgres_ftS  # or 'vector'
CLOUD_MODEL_PROVIDER=openai_like
CLOUD_MODEL_NAME=gpt-light-4k
ONPREM_MODEL_PROVIDER=vllm
ONPREM_MODEL_NAME=edcat-core-13b-q4
SECURE_MODE_DEFAULT=false
LOG_LEVEL=info
