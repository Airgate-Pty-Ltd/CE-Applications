          "paragraph_headers": true,
          "single_spacing": true,
          "no_bullets_for_headers": true
        },
        "qms_rules": {
          "procedures_define": "what",
          "work_instructions_define": "how",
          "no_how_to_in_procedures": true,
          "mdL_linkage_required": true
        },
        "citations": {
          "required": true,
          "format": "[Source: {doc_id} p{page} L{line_start}\u2013L{line_end}]"
        }
      },
      "capabilities": {
        "allowed_tools": [
          "retrieve.clause",
          "retrieve.document",
          "search.index",
          "render.gap.table",
          "draft.template"
        ],
        "refusal_policy": "If no authoritative snippet is retrieved, refuse or ask for the source document."
      }
    },
    {
