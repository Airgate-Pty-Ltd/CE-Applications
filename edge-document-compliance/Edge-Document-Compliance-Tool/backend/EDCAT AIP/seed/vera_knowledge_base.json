            "Production and service provision",
            "Post-market surveillance"
          ],
          "medical_device_specific": [
            "Regulatory requirements vary by region",
            "Risk management is mandatory",
            "Design controls are critical",
            "Post-market surveillance required"
          ]
        }
      }
    },
    "audit_expertise": {
      "description": "Audit preparation and execution knowledge",
      "audit_types": {
        "internal_audit": {
          "purpose": "Verify QMS effectiveness and compliance",
          "frequency": "At least annually, or as planned",
          "key_areas": [
            "Process effectiveness",
            "Document control",
            "Training records",
            "CAPA effectiveness",
            "Management review actions"
          ]
        },
        "external_audit": {
          "purpose": "Certification or surveillance audit",
          "preparation": [
            "Review previous audit findings",
            "Ensure all documents are current",
            "Verify training records are complete",
            "Check CAPA closure status",
            "Prepare management review records"
          ]
        },
        "regulatory_audit": {
          "purpose": "Compliance with regulatory requirements",
          "focus": [
            "Regulatory compliance",
            "Product safety",
            "Documentation accuracy",
            "Process validation"
          ]
        }
      },
      "audit_checklist_items": [
        "All procedures are current and approved",
        "Training records are complete and current",
        "Internal audit schedule is followed",
        "CAPA items are closed or on track",
        "Management review is conducted",
        "Document control is effective",
        "Records are maintained per retention policy"
      ]
    },
    "gap_analysis_expertise": {
      "description": "Gap analysis methodologies and best practices",
      "gap_types": {
        "documentation_gap": "Missing or incomplete procedures/work instructions",
        "implementation_gap": "Procedure exists but not followed in practice",
        "evidence_gap": "No objective evidence to demonstrate compliance",
        "training_gap": "Personnel not trained on requirements"
      },
      "severity_classification": {
        "critical": "Immediate regulatory or safety risk",
        "major": "Significant compliance issue requiring prompt action",
        "minor": "Non-compliance that doesn't affect product/service quality",
        "observation": "Opportunity for improvement"
      },
      "remediation_priorities": [
        "Address critical gaps immediately",
        "Plan major gaps for next review cycle",
        "Schedule minor gaps for continuous improvement",
        "Document observations for future consideration"
      ]
    },
    "procedure_drafting": {
      "description": "Best practices for procedure and work instruction creation",
      "procedure_structure": {
        "purpose": "Why the procedure exists",
        "scope": "What it covers and who it applies to",
        "responsibilities": "Who does what",
        "procedure": "What is done (not how - that's for work instructions)",
        "references": "Related documents",
        "records": "What records are created",
        "revision_history": "Change tracking"
      },
      "work_instruction_structure": {
        "purpose": "Why the work instruction exists",
        "scope": "When to use this instruction",
        "equipment": "What tools/equipment are needed",
        "procedure": "Step-by-step how-to (detailed)",
        "safety": "Safety considerations",
        "quality_checks": "What to verify",
        "troubleshooting": "Common issues and solutions"
      },
      "common_mistakes": [
        "Mixing procedure (what) with work instruction (how)",
        "Missing responsibilities",
        "No revision control",
        "Unclear scope",
        "Missing references to related documents"
      ]
    },
