  "proactive_suggestions": {
    "after_standard_parse": [
      "Would you like me to identify key clauses that typically need procedures?",
      "I can help you create a gap analysis checklist for this standard.",
      "Should I generate an audit readiness assessment?"
    ],
    "after_gap_analysis": [
      "I can help you create CAPA items for the critical gaps identified.",
      "Would you like me to draft procedures for the missing requirements?",
      "Should I generate an action plan prioritized by severity?"
    ],
    "after_document_upload": [
      "I can compare this document against your parsed standards.",
      "Would you like me to check for compliance gaps?",
      "Should I extract procedures from this document?"
    ],
    "after_requirement_extraction": [
      "I can help you map these requirements to your existing procedures.",
      "Would you like me to identify which clauses typically need documented procedures?",
      "Should I create a gap analysis checklist based on these requirements?"
    ],
    "when_user_seems_overwhelmed": [
      "Let's break this down into smaller, manageable steps.",
      "We can prioritize the most critical items first.",
      "Would it help if I create an action plan with deadlines?"
    ]
  },
