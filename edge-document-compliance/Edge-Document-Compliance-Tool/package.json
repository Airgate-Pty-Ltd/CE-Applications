{
  "name": "edcat-compliance-gap",
  "version": "1.0.1",
  "description": "ComplianceGap with Chat - AI-Powered Gap Analysis",
  "main": "backend/index.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run build:vera || echo 'Build warning: TypeScript compilation had issues, continuing anyway...'",
    "start": "node backend/index.js",
    "push": "node .git-push-helper.js",
    "dev": "nodemon backend/index.js",
    "migrate": "node backend/scripts/migrate.js",
    "test": "jest --coverage",
    "lint": "eslint backend/src/",
    "setup-db": "node backend/setup-db.js",
    "migrate:up": "node backend/src/database/migrate.js",
    "migrate:edcat": "node backend/src/scripts/run-migration.js",
    "seed:agent": "node backend/src/scripts/seed-edcat-agent.js",
    "seed:personality": "node backend/src/scripts/seed-edcat-personality.js",
    "seed:vera": "tsx backend/vera/seeds/runVeraSeeds.ts",
    "learn:run": "node backend/src/scripts/learnNightly.js",
    "ingest:knowledge-pack": "node backend/src/scripts/ingest-knowledge-pack.js",
    "regs:refresh": "ENABLE_NET=true node backend/scripts/refresh-regs.js",
    "regs:verify": "node backend/scripts/verify-regs.js",
    "apis:discover": "node backend/src/scripts/discover-apis.js",
    "db:apply-schema": "node backend/scripts/apply-schema.js",
    "db:apply-fixed-schema": "node backend/src/scripts/apply-fixed-schema.js",
    "git:status": "node backend/src/scripts/git-helper.js status",
    "git:add": "node backend/src/scripts/git-helper.js add",
    "git:commit": "node backend/src/scripts/git-helper.js commit",
    "git:push": "node simple-push.js",
    "redeploy": "powershell -ExecutionPolicy Bypass -File redeploy.ps1",
    "git:all": "node backend/src/scripts/git-helper.js all",
    "git:commit-now": "node commit-now.js",
    "git:commit-greeting": "node commit-greeting-system.js",
    "vera:pull-standards": "node backend/src/scripts/pull-vera-learning-standards.js",
    "test:standards": "node backend/src/tests/StandardsIntelligenceService.test.js",
    "test:conversation": "node backend/src/tests/ConversationMemory.test.js",
    "test:vera": "node backend/src/tests/StandardsIntelligenceService.test.js && node backend/src/tests/ConversationMemory.test.js",
    "build:vera": "tsc --project backend/tsconfig.json",
    "check:app": "node --check backend/src/app.js",
    "test:vera-engine": "tsx backend/src/tests/veraChatEngine.test.ts",
    "test:vera-llm-smoke": "tsx backend/src/tests/vera/llmSmokeRunner.ts",
    "ingest:requirements": "node backend/src/scripts/ingest-requirements-comprehensive.js",
    "ingest:terms": "node backend/src/scripts/ingest-terms-definitions.js",
    "seed:regulatory": "node backend/src/scripts/seed-regulatory-standards.js",
    "edcat:init": "node backend/src/scripts/edcat-init.js",
    "fix:columns": "node backend/src/scripts/fix-critical-columns.js"
  },
  "keywords": [
    "compliance",
    "gap-analysis",
    "chat"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vera-ai/client": "file:../VERA-Client",
    "ajv": "^8.17.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.1.3",
    "mammoth": "^1.6.0",
    "multer": "^2.0.0",
    "natural": "^6.7.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.11",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.10.0",
    "pg-promise": "^11.5.0",
    "pino": "^10.1.0",
    "puppeteer": "^24.32.0",
    "string-similarity-js": "^2.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "uuid": "^9.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
