NODE_ENV=development
PORT=3000

# Database Configuration
# Development: use local PostgreSQL
# Production: Railway automatically uses DATABASE_URL from Railway environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edcat_customer_data
EDCAT_AI_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edcat_ai_intelligence

PUBLIC_URL=http://localhost:3000
ENABLE_NET=false

# Optional services (OpenAI removed - Vera is now fully self-contained)
# EMBEDDING_STRATEGY=tfidf (default, no config needed)

# Diagnostics gate (set to 1 only when you intentionally want diagnose mode)
ALLOW_DIAGNOSE=0

# Learning scheduler
LEARN_CRON_ENABLED=false
LEARN_CRON_SPEC=30 2 * * *
LEARN_CRON_TZ=UTC

# ComplianceGap - Ollama Configuration
# Development: Use localhost
# Railway/Production: Use service name for private networking (http://ollama:11434)
# OR use external Ollama instance URL
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RETRIES=3

# Mistral Integration Settings
ENABLE_MISTRAL=true
MISTRAL_ENABLED_IN_CHAT=true
MISTRAL_CACHE_RESPONSES=true
AUTO_START_OLLAMA=true  # Automatically start Ollama when VERA initializes (Windows only, skipped in production)

# Legacy compatibility (only needed if running old scripts)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME_COMPLIANCE=edcat_compliance_library
DB_NAME_CUSTOMER=edcat_customer_data

