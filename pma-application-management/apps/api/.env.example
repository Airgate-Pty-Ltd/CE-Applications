# PMA Autopilot API — environment
# Copy to .env for local development. NEVER commit a real .env.

# Postgres connection string used by the HOST application principal.
DATABASE_URL="postgresql://user:password@localhost:5432/pma_autopilot?schema=public"

# Optional: dedicated M-AI kernel DB principal (SELECT on host, INSERT on mai_* only).
# Provisioned in build order step 3; see docs/mai-kernel.md.
MAI_KERNEL_DATABASE_URL="postgresql://mai_kernel:password@localhost:5432/pma_autopilot?schema=public"

JWT_SECRET="change-me-in-production"
PORT=4000
NODE_ENV=development
