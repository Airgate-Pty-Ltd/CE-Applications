{
  "name": "@pma-autopilot/api",
  "version": "0.1.0",
  "private": true,
  "description": "PMA Autopilot API \u2014 Express + Prisma. Deterministic completeness gate + embedded M-AI kernel. No LLM, no model calls.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json && node -e \"const fs=require('fs'),p=require('path');for(const [s,o] of [[p.join('src','mai','sql'),p.join('dist','mai','sql')],[p.join('src','db'),p.join('dist','db')]]){fs.mkdirSync(o,{recursive:true});for(const f of fs.readdirSync(s)){if(f.endsWith('.sql'))fs.copyFileSync(p.join(s,f),p.join(o,f))}}console.log('copied sql to dist')\"",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "cors": "^2.8.5",
    "docx": "^9.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "pg": "^8.11.3",
    "pdf-lib": "^1.17.1",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "@types/pg": "^8.11.0",
    "@types/adm-zip": "^0.5.5"
  }
}
