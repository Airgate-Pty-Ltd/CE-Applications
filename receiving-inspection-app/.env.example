# -----------------------------------------------------------------------------
# receiving-inspection-app — example environment
#
# Copy to `.env.local` for development. NEVER put a real value in this file.
# `.env*` is git-ignored except this example, and the pre-commit scrub gate will
# reject a commit that carries a credential or a customer identifier.
#
# IMPORTANT — build-time vs runtime.
# Storage and identity configuration belongs to the CUSTOMER and is supplied at
# RUNTIME through in-app configuration, not baked into a build. The variables
# below exist so a developer can run the app locally and so a customer can
# pre-seed a deployment. A production bundle must be usable by a customer who
# sets none of them and configures the app after install.
# -----------------------------------------------------------------------------

# --- Feature flags -----------------------------------------------------------
# Billing scaffold. Default off. Tiers and prices come from config, not code.
VITE_FEATURE_BILLING=
# Test dashboard at /dev/test-dashboard. Dev and staging only. The production
# build asserts this route is absent from the bundle — do not enable for prod.
VITE_FEATURE_TEST_DASHBOARD=

# --- Storage adapter ---------------------------------------------------------
# Which provider backs the record store: sharepoint | webdav | s3 | local
VITE_STORAGE_PROVIDER=
# Folder convention. Default: /{year}/{supplier}/{receipt-id}/
VITE_STORAGE_FOLDER_TEMPLATE=

# SharePoint (Microsoft Graph) — the primary provider.
VITE_SHAREPOINT_SITE_URL=
VITE_SHAREPOINT_DRIVE_ID=
VITE_SHAREPOINT_LIBRARY_NAME=

# WebDAV / network share.
VITE_WEBDAV_BASE_URL=

# S3-compatible object storage. Never place a secret key here; the app uses
# short-lived credentials or a pre-signed endpoint supplied at runtime.
VITE_S3_ENDPOINT=
VITE_S3_REGION=
VITE_S3_BUCKET=

# --- Identity and roles ------------------------------------------------------
# entra | oidc. The app is never the source of truth for identity.
VITE_AUTH_PROVIDER=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_REDIRECT_URI=
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=

# Group-to-role mapping. Values are group object ids or names in the customer's
# directory. Roles: inspector | supervisor | quality-manager | read-only
VITE_ROLE_GROUP_INSPECTOR=
VITE_ROLE_GROUP_SUPERVISOR=
VITE_ROLE_GROUP_QUALITY_MANAGER=
VITE_ROLE_GROUP_READ_ONLY=

# --- Record policy -----------------------------------------------------------
# Retention in years. The app enforces a regulatory floor and refuses to accept
# a value below it for the selected operating basis. Configurable upward only.
VITE_RETENTION_YEARS=
# Operating basis driving the retention floor, e.g. a repair-station basis.
VITE_OPERATING_BASIS=

# --- Sync and concurrency ----------------------------------------------------
# Minutes before an idle record lock expires so a dead tablet cannot block the
# receiving dock.
VITE_LOCK_TIMEOUT_MINUTES=

# --- Integration seam --------------------------------------------------------
# One documented outbound webhook. No connector to any named ERP is built.
VITE_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# CI note: the scrub gate reads optional extra denied terms from the
# SCRUB_EXTRA_TERMS environment variable, supplied in CI from a repository
# secret named SCRUB_TERMS. It is referenced by name only and never stored here.
# -----------------------------------------------------------------------------
