{
  "name": "car-8d-desktop",
  "version": "1.0.0",
  "description": "CAR 8D Desktop Application - Corrective Action Report Tool",
  "type": "module",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:electron\"",
    "dev:backend": "node backend/server.js",
    "dev:electron": "vite && electron .",
    "dev:vite": "vite",
    "preview": "vite preview",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "build:all": "vite build && electron-builder -mwl",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .jsx,.js",
    "format": "prettier --write \"src/**/*.{jsx,js,css}\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "nanoid": "^4.0.0",
    "pdfkit": "^0.13.0",
    "three": "^r154"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.0",
    "electron-dev-tools-installer": "^3.2.0",
    "concurrently": "^8.2.0",
    "express": "^4.18.0",
    "sqlite3": "^5.1.0",
    "sqlite": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "prop-types": "^15.8.0",
    "vitest": "^1.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "prettier": "^3.0.0",
    "@playwright/test": "^1.40.0"
  },
  "build": {
    "appId": "com.conform-edge.car8d",
    "productName": "CAR 8D",
    "files": [
      "dist/**/*",
      "backend/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
