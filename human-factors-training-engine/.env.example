# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hf_training_dev"

# Node Environment
NODE_ENV="development"

# Application
NEXTAUTH_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
SESSION_TTL_SECONDS="43200"
# Set true only behind a trusted reverse proxy that overwrites forwarded address headers.
TRUST_PROXY_HEADERS="false"
# Legacy compatibility; new deployments should use SESSION_SECRET.
JWT_SECRET="replace-with-at-least-32-random-bytes"
MAI_KERNEL_PASSWORD="replace-with-a-separate-32-character-database-role-secret"

# Optional continuous server-folder intake. Leave HF_INGEST_ROOT unset for web-upload only.
HF_INGEST_ROOT=""
# Required whenever HF_INGEST_ROOT is set. Use the real organization ID shown in administration.
HF_INGEST_ORGANIZATION_ID=""
HF_INGEST_POLL_MS="15000"
HF_INGEST_RECORD_TYPE="organizational_data"
HF_INGEST_CLASSIFICATION="INTERNAL"
HF_MAX_INGEST_BYTES="20971520"
# production: windows-defender or clamav; none is development-only unless explicitly overridden
HF_AV_SCANNER="none"
HF_ALLOW_UNSCANNED_INGESTION="false"

# Hosted-folder connector agent (run separately at the training department).
# The raw token is displayed only once when an administrator creates the connector.
HF_CONNECTOR_ROOT=""
HF_CONNECTOR_STATE_PATH=""
HF_HOSTED_URL="https://hf-engine.example.com"
HF_CONNECTOR_TOKEN=""
HF_CONNECTOR_POLL_MS="15000"
HF_CONNECTOR_RECORD_TYPE="organizational_data"
HF_CONNECTOR_CLASSIFICATION="INTERNAL"

# Notifications. "disabled" never claims delivery; "console" is development-only.
# webhook must be an HTTPS endpoint that accepts the documented JSON payload.
HF_EMAIL_MODE="disabled"
HF_EMAIL_WEBHOOK_URL=""
HF_EMAIL_WEBHOOK_TOKEN=""
HF_EMAIL_FROM=""

# Optional: Error tracking
SENTRY_DSN=""

# Optional: Analytics
GOOGLE_ANALYTICS_ID=""
