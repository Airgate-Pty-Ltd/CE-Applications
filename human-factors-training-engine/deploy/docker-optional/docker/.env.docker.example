#
# Copy to deploy/docker-optional/docker/.env.docker and fill in real values before running,
# from the deploy/docker-optional/ directory:
# `docker compose --env-file docker/.env.docker --profile onprem up --build`
# Never commit docker/.env.docker itself (gitignored — see .gitignore).

# Required for both profiles
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-different-long-random-string
SESSION_TTL_SECONDS=43200
# Host folder mounted read-only into the on-prem container for continuous ingestion.
HF_INGEST_HOST_PATH=./incoming

# Required for --profile online only (postgres service + app-online)
POSTGRES_USER=hfengine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hfengine
AI_PROVIDER_MODE=none
AUTH_MODE=local
