{
  "name": "hf-training-platform",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Human Factors Training Platform — Phase 1 (Web MVP)",
  "author": "Conform-Edge Quality Consulting LLC",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:license-headers && npm run verify:kernel",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --quiet",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:license-headers": "node scripts/check-license-headers.js",
    "verify:kernel": "node scripts/verify-kernel-vendor.js",
    "ingest:folder": "tsx scripts/folder-ingestion-worker.ts",
    "ingest:folder:once": "tsx scripts/folder-ingestion-worker.ts --once",
    "connector:hosted": "tsx scripts/hosted-folder-connector.ts",
    "connector:hosted:once": "tsx scripts/hosted-folder-connector.ts --once",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:triggers": "prisma db execute --file prisma/manual-sql/frozen_manifest_trigger.sql --schema prisma/schema.prisma && prisma db execute --file prisma/manual-sql/frozen_manifest_trigger_v2_widen_superseded.sql --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-phase3-demo-users.ts",
    "db:seed:regulatory-clauses": "tsx prisma/seed-regulatory-clauses.ts",
    "db:seed:baseline-content": "tsx prisma/seed-baseline-content.ts",
    "db:seed:faa-part145-pack": "tsx prisma/seed-faa-part145-pack.ts",
    "db:seed:kernel-rule-manifest": "tsx prisma/seed-kernel-rule-manifest.ts",
    "db:seed:authority-profiles": "tsx prisma/seed-authority-profiles.ts",
    "db:setup": "npm run db:migrate:deploy && npm run db:triggers && npm run db:seed && npm run db:seed:demo && npm run db:seed:regulatory-clauses && npm run db:seed:baseline-content && npm run db:seed:faa-part145-pack && npm run db:seed:kernel-rule-manifest && npm run db:seed:authority-profiles",
    "db:studio": "prisma studio",
    "db:generate:pg": "node scripts/generate-postgres-schema.js && prisma generate --schema prisma/postgresql/schema.prisma",
    "db:migrate:pg": "npm run db:generate:pg && prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:triggers:pg": "prisma db execute --file prisma/postgresql/manual-sql/frozen_manifest_trigger.sql --schema prisma/postgresql/schema.prisma",
    "db:mai-kernel-role:pg": "prisma db execute --file prisma/postgresql/manual-sql/mai_kernel_role.sql --schema prisma/postgresql/schema.prisma && tsx scripts/provision-mai-kernel-role.ts",
    "db:seed:pg": "tsx prisma/seed.ts",
    "db:seed:demo:pg": "tsx prisma/seed-phase3-demo-users.ts",
    "db:setup:pg": "npm run db:migrate:pg && npm run db:triggers:pg && npm run db:seed:pg && npm run db:seed:demo:pg",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mai/kernel": "file:vendor/m-ai-kernel/ba2a1cf-f81fbf10/runtime",
    "@prisma/client": "^5.0.0",
    "@types/diff": "^7.0.2",
    "bcryptjs": "^2.4.3",
    "diff": "^9.0.0",
    "dotenv": "17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.2",
    "jspdf": "4.2.1",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "16.3.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jest": "^29.0.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.9",
    "typescript": "^5.0.0"
  }
}
